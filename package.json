{
  "name": "yusufclaw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "pnpm build && vitest run --maxWorkers=2",
    "check": "pnpm typecheck && pnpm test",
    "cli": "pnpm build && node packages/gateway/dist/main.js cli",
    "telegram": "pnpm build && node packages/gateway/dist/main.js telegram"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "~5.7.3",
    "vitest": "^3.2.4"
  }
}
