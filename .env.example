# Copy to .env. Never commit real credentials or tokens.
MODEL_PROVIDER=bedrock
AWS_PROFILE=yusufclaw
AWS_REGION=us-east-1
# Required for Bedrock: choose a Converse/tool-use-capable model or inference profile
# enabled in your account. No default is assumed.
BEDROCK_MODEL_ID=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
MEMORY_PATH=.data/memory.sqlite
CLI_USER_ID=local
MAX_TOKENS=2048
MODEL_TIMEOUT_MS=120000
MAX_AGENT_STEPS=8
HISTORY_TURNS=20

# Telegram: uncomment and fill both values before running pnpm telegram.
# TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_ALLOWED_USER_IDS=

# OpenAI-compatible Chat Completions (MODEL_PROVIDER=openai).
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=your-tool-capable-model

# Web chat: set a random private token before running pnpm web.
WEB_HOST=127.0.0.1
WEB_PORT=3000
WEB_USER_ID=local
# WEB_AUTH_TOKEN=replace_with_a_random_private_token

# Trusted local Markdown instructions; loaded at startup.
SKILLS_DIR=skills
# Optional JSON routines file, loaded by web/telegram/routines modes.
# ROUTINES_CONFIG=.data/routines.json

# WhatsApp Business Cloud API (disabled unless configured).
# WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_APP_SECRET=replace_with_meta_app_secret
# WHATSAPP_VERIFY_TOKEN=replace_with_webhook_verify_token
# WHATSAPP_ALLOWED_NUMBERS=15550234567,905551234567

# Voice Subsystem: STT and TTS protocols (disabled unless configured).
# VOICE_ENABLED=false
# VOICE_STT_PROVIDER=fake
# VOICE_TTS_PROVIDER=fake
# VOICE_REPLY_AS_AUDIO=false
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# WHISPER_MODEL_SIZE=base
# POLLY_VOICE_ID=Joanna
